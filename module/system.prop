# Triango ARM32 Bridge — system properties (v1.0)
#
# 1) ABI reklamı: INSTALL_FAILED_NO_MATCHING_ABIS çözümü (docs/abi-fix.md).
#    Kapatma: /data/adb/triango/config/disable_abilist32
# 2) NativeBridge: ART, arm32 yerel kütüphanelerini Triango çeviri motoru
#    üzerinden yükler (docs/nativebridge.md).  İki yol:
#      a) systemless (tam yeniden başlatma sonrası mount): modül system/lib64
#      b) soft-reboot yolu: activate.sh /data/adb/triango/lib + linkerconfig
#    Değer mutlak yol olursa (b) yolu kullanılır; activate.sh ayarlar.
#    Kapatma: /data/adb/triango/config/disable_nativebridge
#
# NOT: Kod çalıştırma zinciri tamamlanana kadar uygulama düzeyi arm32
# çalıştırma deneyseldir (roadmap v0.3/v0.4). Kurulum/akış açıktır.
ro.product.cpu.abilist=arm64-v8a,armeabi-v7a,armeabi
ro.product.cpu.abilist32=armeabi-v7a,armeabi
ro.product.cpu.abilist64=arm64-v8a
ro.vendor.product.cpu.abilist=arm64-v8a,armeabi-v7a,armeabi
ro.vendor.product.cpu.abilist32=armeabi-v7a,armeabi
ro.dalvik.vm.native.bridge=libtriango_native_bridge.so
